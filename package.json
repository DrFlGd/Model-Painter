{
  "name": "model-painter",
  "version": "0.3.0",
  "private": true,
  "description": "Paint 3D models for multi-colour printing: from their textures, or by hand, into a painted 3MF",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "smoke": "vite build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "d3-contour": "^4.0.3",
    "manifold-3d": "^3.5.4",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/d3-contour": "^3.0.6",
    "@types/node": "^22.20.5",
    "@types/three": "0.170.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
