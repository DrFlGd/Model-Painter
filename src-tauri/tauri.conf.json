{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Model Painter",
  "version": "0.1.0",
  "identifier": "com.drflgd.modelpainter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Model Painter",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Graphics",
    "shortDescription": "Paint 3D models for colour printing",
    "longDescription": "Open a model in glTF, OBJ, FBX, Collada, 3DS, PLY, PSK, STL or 3MF with its textures, paint it from them or by hand, and save a painted 3MF for Bambu Studio, OrcaSlicer or PrusaSlicer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
